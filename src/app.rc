#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "GpsAssistUpdater.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments",         "Writes Sony GPS assist data (assistme.dat) to a camera memory card. Not made by Sony."
            VALUE "FileDescription",  "GPS Assist Data Updater"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "GpsAssistUpdater"
            VALUE "OriginalFilename", "GpsAssistUpdater.exe"
            VALUE "ProductName",      "GPS Assist Data Updater"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
